# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets / local env (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Machine-specific / local tooling
.blender/
*.blend1
tools/

# Generated renders & regenerable image artifacts
out/renders/
out/renders_variants/
out/derivatives/
out/contact_sheets/
**/*.png
!**/.gitkeep

# Keep curated art-direction refs that are source material (not pipeline output)
!docs/refs/**/*.png

# Product-canonical style sheets (material-only boards; versioned with styles JSON)
!product/assets/**/*.png

# Mobile Expo mock / branded PNGs (bundled for MOCK mode)
!mobile/assets/**/*.png

# Large archives & bundles
*.tar
*.tar.gz
*.tgz
*.zip
out/*.tar.gz
out/stylization_lab_deliverables.tar.gz

# Logs
*.log
out/metrics/logs/

# Large source PDF (keep locally / share separately; not first-push)
docs/refs/recipe-pdf/
**/*Recipe*.pdf
**/*recipe*.pdf

# Recipe page dumps (regenerable from PDF)
docs/refs/recipe-pages/

# Golden preview rasters (JSON is source of truth)
corpus/golden/*_preview.png


# V2 quality-pass: ignore PNG/binaries under out/v2 but keep text summaries
out/v2/**/*.png
out/v2/**/*.jpg
out/v2/**/*.webp
out/v2/**/renders/
out/v2/**/derivatives/
out/v2/**/contact_sheets/
out/v2/**/logs/
out/v2/_sil/
out/v2/smoke_*.png

# V3 POC: keep JSON blueprints + markdown; ignore generated rasters
out/v3/**/*.png
out/v3/**/*.jpg
out/v3/**/*.webp
out/v3/**/renders_2048/
out/v3/**/stickers/
out/v3/**/logs/
out/v3/**/jobs/

# V4 AI rendering: ignore generated rasters / smoke binaries; keep source + small markdown
out/v4/**/*.png
out/v4/**/*.jpg
out/v4/**/*.jpeg
out/v4/**/*.webp
out/v4/smoke/

# V4 doodle-fidelity test outputs (prompts/meta/json copies + review stay local)
out/v4/tests/
out/v4/DOODLE_FIDELITY_REVIEW.md

# V4.1 fidelity+delight pass outputs (rasters already covered by out/v4/**/*.png)
out/v4/v41/
out/v4/V41_FIDELITY_DELIGHT_REVIEW.md

# V4.2 unseen pack outputs (rasters already covered by out/v4/**/*.png)
out/v4/v42/
out/v4/v42/V42_UNSEEN_REVIEW.md

.xai_env

# V4.3 multi-style pack (keep review/system MDs; rasters already covered by out/v4/**/*.png)
out/v4/v43/**
!out/v4/v43/
!out/v4/v43/STYLE_SYSTEM.md
!out/v4/v43/TRANSFORM_REVIEW.md
!out/v4/v43/FAILURE_REPORT.md

# V4.4 semantic parsing pack (keep review/system MDs; rasters already covered by out/v4/**/*.png)
out/v4/v44/**
!out/v4/v44/
!out/v4/v44/SEMANTIC_PARSING.md
!out/v4/v44/REGRESSION_REVIEW.md
!out/v4/v44/FAILURE_REPORT.md
