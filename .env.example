# Dooji / Doodle Emoji — server-only secrets (never commit real values)
# Copy to .env and load in your process manager. Mobile clients must NOT get these.

# Required for live xAI Imagine edits (XAIImageProvider)
XAI_API_KEY=

# Image backend: xai | mock  (default: mock when key unset, else xai)
IMAGE_PROVIDER=mock

# Optional: persist final PNGs under this directory
# DOOJI_OUT=out/product

# Optional HTTP stub
# DOOJI_HOST=127.0.0.1
# DOOJI_PORT=8080

# --- Live vertical slice (ONE generation — spends credits) ---
# DOOJI_LIVE=1
# IMAGE_PROVIDER=xai
# python3 -m scripts.run_live_gummy_once
# Defaults: Gummy, resolution=1k, quality=low, n=1
