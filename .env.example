# Dooji / Doodle Emoji — server-only secrets (never commit real values)
# Copy to .env and load in your process manager. Mobile clients must NOT get these.

# Environment: development (default) | production
# Production fails closed: requires IMAGE_PROVIDER=xai + XAI_API_KEY, disables dry_run/doodle_path/dev tools.
# DOOJI_ENV=production

# Required for live xAI Imagine edits (XAIImageProvider)
XAI_API_KEY=

# Image backend: xai | mock
# Development: mock when key unset, else xai
# Production: must be xai (mock rejected)
IMAGE_PROVIDER=mock

# Emergency kill switch — reject NEW provider generations (cache still works; no quota charge)
# DOOJI_GENERATIONS_DISABLED=1

# Optional: persist final PNGs under this directory
# DOOJI_OUT=out/product

# Bind (hosted platforms often inject PORT)
# DOOJI_HOST=0.0.0.0
# DOOJI_PORT=8080
# PORT is used when DOOJI_PORT is unset
# Localhost-only override: DOOJI_HOST=127.0.0.1

# Request limits (defaults shown)
# DOOJI_MAX_BODY_BYTES=8000000
# DOOJI_MAX_IMAGE_BYTES=5000000
# DOOJI_MAX_STROKES=2000

# Provider deadlines (seconds)
# DOOJI_PROVIDER_TIMEOUT_S=90
# DOOJI_PROVIDER_HTTP_TIMEOUT_S=60
# DOOJI_PROVIDER_DOWNLOAD_TIMEOUT_S=45

# Quota (defaults: 6 / 24h per anon client, 500 global / 24h)
# DOOJI_ANON_GENERATION_LIMIT=6
# DOOJI_GLOBAL_DAILY_BUDGET=500
# DOOJI_POLICY=file
# DOOJI_POLICY_PATH=

# Local QA only — NEVER enable in production
# DOOJI_DEV_TOOLS=1
# DOOJI_ALLOW_DOODLE_PATH=1

# --- Live vertical slice (ONE generation — spends credits) ---
# DOOJI_LIVE=1
# IMAGE_PROVIDER=xai
# python3 -m scripts.run_live_gummy_once
