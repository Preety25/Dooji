# Mobile public env only — NEVER put XAI_API_KEY here.
#
# DEVELOPMENT (Expo Go / local):
#   EXPO_PUBLIC_APP_ENV=development
#   EXPO_PUBLIC_TRANSFORM_MODE=mock   (default when unset)
#   or http + LAN URL for device E2E against local API
#
# PRODUCTION builds (EAS / release):
#   EXPO_PUBLIC_APP_ENV=production
#   EXPO_PUBLIC_TRANSFORM_MODE=http
#   EXPO_PUBLIC_TRANSFORM_API_URL=https://your-api.example.com
#   Missing/invalid values fail closed (no silent mock/localhost).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_TRANSFORM_MODE=http
EXPO_PUBLIC_TRANSFORM_API_URL=http://YOUR_LAN_IP:8080

# Optional client AbortController timeout (ms). Default 90000.
# EXPO_PUBLIC_TRANSFORM_TIMEOUT_MS=90000

# Discover LAN IP:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
#   Windows (PowerShell): (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -match 'Wi-Fi|WLAN' }).IPAddress
