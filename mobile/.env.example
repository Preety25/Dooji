# Mobile public env only — NEVER put XAI_API_KEY here.
# Copy to mobile/.env and replace YOUR_LAN_IP with your computer's Wi-Fi IPv4.
# Discover IP:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
#   Windows (PowerShell): (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -match 'Wi-Fi|WLAN' }).IPAddress

EXPO_PUBLIC_TRANSFORM_MODE=http
EXPO_PUBLIC_TRANSFORM_API_URL=http://YOUR_LAN_IP:8080
